#, c-format
msgid "Output variables or root: %s: "
msgstr "Variáveis de saída ou raiz: %s: "

#: STATS_MIXED_CLUSTER2.R:416
#, c-format
msgid "Integer variables must have a scale measurement level: %s"
msgstr ""
"As variáveis de número inteiro devem ter um nível de medição de escala: %s"

#: STATS_MIXED_CLUSTER2.R:426
#, c-format
msgid ""
"A nonnumeric or negative value was found in an integer variable.  Set to missing:\n"
" %s"
msgstr ""
"Um valor não numérico ou negativo foi encontrado em uma variável de número inteiro.  Configurado como ausente:\n"
" %s"

#: STATS_MIXED_CLUSTER2.R:450
msgid "Estimation or new data dataset is required"
msgstr "É necessário um conjunto de dados para estimação ou para novos dados"

#: STATS_MIXED_CLUSTER2.R:498
#, c-format
msgid "Probability variable names cannot already be in use: %s"
msgstr "Os nomes das variáveis de probabilidade não podem já estar em uso: %s"

#: STATS_MIXED_CLUSTER2.R:510
#, c-format
msgid "Predictions saved to %s"
msgstr "As predições foram salvas em %s"

#: STATS_MIXED_CLUSTER2.R:541
#, c-format
msgid "Imputed data saved to dataset %s"
msgstr "Os dados imputados foram salvos no conjunto de dados %s"

