#: STATS_MIXED_CLUSTER2.R:97
msgid "End of procedure"
msgstr "Fin del procedimiento"

#: STATS_MIXED_CLUSTER2.R:127
msgid "Message Number"
msgstr "Número de mensaje"

#: STATS_MIXED_CLUSTER2.R:165
#, c-format
msgid "Invalid variable name: %s"
msgstr "Nombre de variable no válido: %s"

#: STATS_MIXED_CLUSTER2.R:179
#, c-format
msgid "Output variable already exists: %s"
msgstr "La variable de salida ya existe: %s"

#: STATS_MIXED_CLUSTER2.R:185 STATS_MIXED_CLUSTER2.R:289
msgid "Mixed Cluster2"
msgstr "Cluster2 mixto"

#: STATS_MIXED_CLUSTER2.R:186
msgid "Mixed Cluster2 Messages and Warnings"
msgstr "Mensajes y advertencias de Cluster2 mixto"

#: STATS_MIXED_CLUSTER2.R:212
msgid "Number of components must be specified if not using existing model"
msgstr ""
"Si no se emplea un modelo existente, se debe especificar el número de "
"componentes."

#: STATS_MIXED_CLUSTER2.R:220
msgid "Split files is not supported by this procedure"
msgstr "Este procedimiento no permite archivos segmentados"

#: STATS_MIXED_CLUSTER2.R:223
msgid "Case weights are not supported by this procedure and will be ignored"
msgstr ""
"Este procedimiento no admite ponderaciones de casos y estas se ignorarán."

#: STATS_MIXED_CLUSTER2.R:228
msgid "Cannot save model if using existing model.  Outmodel will be ignored"
msgstr ""
"Si se está utilizando un modelo existente, no se puede guardar el modelo.  "
"Outmodel se ignorará."

#: STATS_MIXED_CLUSTER2.R:243 STATS_MIXED_CLUSTER2.R:254
msgid "Model file does not contain a model"
msgstr "El archivo de modelo no contiene ningún modelo."

#: STATS_MIXED_CLUSTER2.R:247
#, c-format
msgid "Model file %s not found or could not be read"
msgstr "El archivo de modelo %s no se ha encontrado o no se ha podido leer."

#: STATS_MIXED_CLUSTER2.R:257
msgid "No variables were specified"
msgstr "No se han especificado variables."

#: STATS_MIXED_CLUSTER2.R:261
msgid "A required input was not specified"
msgstr "No se ha especificado un dato obligatorio."

#: STATS_MIXED_CLUSTER2.R:271
msgid "An ID variable is required if imputing missing values"
msgstr "Se necesita una variable de ID si se imputan valores que faltan"

#: STATS_MIXED_CLUSTER2.R:275
msgid "The imputed dataset name is already in use"
msgstr "El nombre del conjunto de datos imputado ya se está usando"

#: STATS_MIXED_CLUSTER2.R:279
msgid "The ID variable cannot be in the clustering variables list"
msgstr ""
"La variable ID no puede estar en la lista de variables de agrupación en "
"clúster"

#: STATS_MIXED_CLUSTER2.R:303
#, c-format
msgid "The required variables are %s"
msgstr "Las variables requeridas son %s."

#: STATS_MIXED_CLUSTER2.R:305
#, c-format
msgid ""
"error fetching data\n"
"%s"
msgstr ""
"error al obtener datos\n"
"%s"

#: STATS_MIXED_CLUSTER2.R:310
msgid "The ID variable contains duplicate values"
msgstr "La variable ID contiene valores duplicados"

#: STATS_MIXED_CLUSTER2.R:323
#, c-format
msgid "Invalid variable selection criterion: %s"
msgstr "Criterio no válido para la selección de variables: %s"

#: STATS_MIXED_CLUSTER2.R:335
#, c-format
msgid "Estimation Failed: %s"
msgstr "Estimación fallida: %s"

#: STATS_MIXED_CLUSTER2.R:337
#, c-format
msgid "Estimation Warning: %s"
msgstr "Aviso de estimación: %s"

#: STATS_MIXED_CLUSTER2.R:346
msgid "Procedure is unable to find any clusters"
msgstr "El procedimiento no puede encontrar ningún clúster."

#: STATS_MIXED_CLUSTER2.R:357
#, c-format
msgid "Estimated model saved to file %s"
msgstr "Modelo estimado guardado en un archivo %s"

#: STATS_MIXED_CLUSTER2.R:360
#, c-format
msgid "package VarSelLCM, version %s"
msgstr "paquete VarSelLCM, versión %s"

#: STATS_MIXED_CLUSTER2.R:366
msgid ""
"Unable to produce the plot.  Model is deficient or discrimination is zero"
msgstr ""
"No se puede generar el gráfico.  El modelo es deficiente o la discriminación"
" es inexistente."

#: STATS_MIXED_CLUSTER2.R:384
#, c-format
msgid "Output variables or root: %s: "
msgstr "Variables de salida o raíz: %s: "

#: STATS_MIXED_CLUSTER2.R:416
#, c-format
msgid "Integer variables must have a scale measurement level: %s"
msgstr "Las variables enteras deben tener un nivel de medición de escala: %s"

#: STATS_MIXED_CLUSTER2.R:426
#, c-format
msgid ""
"A nonnumeric or negative value was found in an integer variable.  Set to missing:\n"
" %s"
msgstr ""
"Se ha encontrado un valor no numérico o negativo en una variable de tipo entero.  Configurar como perdido:\n"
" %s"

#: STATS_MIXED_CLUSTER2.R:450
msgid "Estimation or new data dataset is required"
msgstr "Se requiere una estimación o un nuevo conjunto de datos."

#: STATS_MIXED_CLUSTER2.R:498
#, c-format
msgid "Probability variable names cannot already be in use: %s"
msgstr ""
"Los nombres de las variables de probabilidad no pueden estar ya en uso: %s"

#: STATS_MIXED_CLUSTER2.R:510
#, c-format
msgid "Predictions saved to %s"
msgstr "Predicciones guardadas en %s"

#: STATS_MIXED_CLUSTER2.R:541
#, c-format
msgid "Imputed data saved to dataset %s"
msgstr "Datos imputados guardados en el conjunto de datos %s"

