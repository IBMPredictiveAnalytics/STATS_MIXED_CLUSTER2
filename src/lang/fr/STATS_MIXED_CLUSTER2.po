#: STATS_MIXED_CLUSTER2.R:97
msgid "End of procedure"
msgstr "Fin de la procédure"

#: STATS_MIXED_CLUSTER2.R:127
msgid "Message Number"
msgstr "Numéro de message"

#: STATS_MIXED_CLUSTER2.R:165
#, c-format
msgid "Invalid variable name: %s"
msgstr "Nom de variable non valide : %s"

#: STATS_MIXED_CLUSTER2.R:179
#, c-format
msgid "Output variable already exists: %s"
msgstr "La variable de sortie existe déjà : %s"

