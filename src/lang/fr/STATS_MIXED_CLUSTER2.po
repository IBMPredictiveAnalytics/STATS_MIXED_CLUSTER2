#, c-format
msgid "package VarSelLCM, version %s"
msgstr "package VarSelLCM, version %s"

#: STATS_MIXED_CLUSTER2.R:366
msgid ""
"Unable to produce the plot.  Model is deficient or discrimination is zero"
msgstr ""
"Impossible de générer le graphique.  Le modèle présente des lacunes ou la "
"discrimination est nulle"

