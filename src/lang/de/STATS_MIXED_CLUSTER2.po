msgstr "Abgelaufene Zeit (Sekunden)"

#: STATS_MIXED_CLUSTER2.R:572
msgid "Estimation Date"
msgstr "Schätzungsdatum"

#: STATS_MIXED_CLUSTER2.R:587
msgid "Yes"
msgstr "Ja"

#: STATS_MIXED_CLUSTER2.R:587
msgid "No"
msgstr "Nein"

